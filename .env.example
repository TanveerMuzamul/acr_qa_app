# ----------------------------
# Flask application settings
# ----------------------------
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
UPLOAD_FOLDER=instance/uploads
UPLOAD_MAX_MB=1024

# ----------------------------
# Database settings
# Local development default: SQLite
# For PostgreSQL, replace DATABASE_URL with a postgres URL.
# Example:
# DATABASE_URL=postgresql+psycopg://mriqa_user:change_this_password@db:5432/mriqa
# ----------------------------
DATABASE_URL=sqlite:///app.db

# ----------------------------
# Optional AWS S3 settings
# Leave empty to keep uploads only on local disk.
# ----------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=mri-qa
AWS_S3_ENABLED=0
